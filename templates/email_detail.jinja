{% from "_message.jinja" import message_card, remote_banner %}
<div id="email-detail-pane" class="flex-1 min-h-0 p-6 bg-white overflow-y-auto custom-scrollbar">
    {% if message.remote_blocked %}{{ remote_banner(remote_url) }}{% endif %}
    {% call message_card(message) %}
        {% if thread_id %}
        <button type="button"
                class="flex items-center gap-1 text-sm font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 px-2 py-0.5 rounded-full"
                hx-get="/api/email_thread/{{ thread_id | urlencode }}"
                hx-target="#detail-pane"
                hx-swap="innerHTML"
                hx-indicator="#loading-indicator">
            <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path></svg>
            <span>{{ thread_count }} messages</span>
        </button>
        {% endif %}
    {% endcall %}
</div>
