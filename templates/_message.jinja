{% macro message_card(message, heading=True) %}
<article class="border-l-2 border-indigo-200 pl-4 py-4 bg-white shadow-sm rounded-lg">
    <header class="flex justify-between items-start gap-4 mb-3 {% if heading %}border-b border-gray-100 pb-2{% endif %}">
        <div class="space-y-1 min-w-0">
            {% if heading %}
            <h2 class="text-2xl font-extrabold text-gray-900 break-words">{{ message.subject or "(no subject)" }}</h2>
            {% endif %}
            <p class="text-sm font-medium text-gray-700 break-words">From: {{ message.from_email }}</p>
            {% if message.to_email %}
            <p class="text-xs text-gray-500 break-words">To: {{ message.to_email }}</p>
            {% endif %}
        </div>
        <div class="flex flex-col items-end gap-2 pt-1 shrink-0">
            <time class="text-xs text-gray-500">{{ message.date | format_date }}</time>
            {{ caller() if caller is defined else "" }}
        </div>
    </header>
    {% if message.attachments %}
    <div class="flex flex-wrap gap-2 mb-3">
        {% for att in message.attachments %}
        <a href="/api/attachment/{{ message.message_id | urlencode }}/{{ loop.index0 }}"
           class="inline-flex items-center px-3 py-1 text-sm font-medium bg-white text-gray-700 rounded-full border border-indigo-300 shadow-sm hover:bg-indigo-50">
            <svg class="w-4 h-4 mr-2 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path></svg>
            {{ att.filename }}
            <span class="ml-2 text-xs text-indigo-400 font-normal">{{ att.size_bytes | format_size }}</span>
        </a>
        {% endfor %}
    </div>
    {% endif %}
    <iframe class="email-frame w-full border-0 bg-white rounded"
            title="Email body"
            sandbox="allow-scripts allow-popups allow-popups-to-escape-sandbox"
            referrerpolicy="no-referrer"
            style="height: 150px"
            srcdoc="{{ message.frame_html }}"></iframe>
</article>
{% endmacro %}

{% macro remote_banner(url) %}
<div class="mb-4 flex items-center justify-between gap-3 rounded-lg border border-amber-200 bg-amber-50 px-4 py-2 text-sm text-amber-800">
    <span>Remote images are blocked to protect your privacy.</span>
    <button type="button"
            class="shrink-0 font-semibold text-amber-900 underline hover:no-underline"
            hx-get="{{ url }}"
            hx-target="#detail-pane"
            hx-swap="innerHTML"
            hx-indicator="#loading-indicator">Load remote images</button>
</div>
{% endmacro %}
