<div class="list-item email-list-item cursor-pointer p-4 border-b border-gray-200 hover:bg-gray-100 transition duration-150 border-l-4 border-l-transparent"
     hx-get="/api/email/{{ email.message_id | urlencode }}"
     hx-target="#detail-pane"
     hx-swap="innerHTML"
     hx-indicator="#loading-indicator">
    <div class="flex justify-between items-center gap-2">
        <p class="font-medium text-gray-900 truncate">{{ email.from_email }}</p>
        <span class="text-xs text-gray-500 shrink-0">{{ email.date | format_date }}</span>
    </div>
    <p class="text-sm text-gray-700 truncate mt-1">{{ email.subject or "(no subject)" }}</p>
    {% if email.excerpt %}
    <p class="text-xs text-gray-500 truncate mt-1">{{ email.excerpt }}</p>
    {% endif %}
    {% if next_url %}
    <div hx-get="{{ next_url }}"
         hx-trigger="intersect once"
         hx-target="#email-list-container"
         hx-swap="beforeend"></div>
    {% endif %}
</div>
