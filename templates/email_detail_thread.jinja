{% from "_message.jinja" import message_card, remote_banner %}
<div id="email-detail-pane" class="flex-1 min-h-0 p-6 bg-white overflow-y-auto custom-scrollbar">
    {% if messages | selectattr("remote_blocked") | list %}{{ remote_banner(remote_url) }}{% endif %}
    <p class="mb-4 text-sm font-semibold text-gray-600">{{ thread_count }} messages in this thread, oldest first</p>
    <div class="space-y-6">
        {% for message in messages %}
        {{ message_card(message, heading=loop.first) }}
        {% endfor %}
    </div>
</div>
