# MBOX Viewer Configuration
# Copy this file to .env and adjust the values for your environment

# Path to the MBOX file to process and view
# This should be an absolute path to your .mbox file
MBOX_FILE_PATH=/Users/tomastrnka/Downloads/bigger_example.mbox

# Ollama server URL for embeddings
# Used for RAG (Retrieval Augmented Generation) search functionality
OLLAMA_URL=http://localhost:11434/api/embed

# Ollama embedding model used when building the index. The model name and vector
# size are recorded in the index, and searches always use the recorded model;
# switching models requires `python email_utils.py index --rebuild`.
# Common options: embeddinggemma, nomic-embed-text, mxbai-embed-large
OLLAMA_MODEL=embeddinggemma

# Path to the DuckDB index (default: emails.db)
# EMAILS_DB_PATH=emails.db

# Web server bind address; keep 127.0.0.1 unless you add authentication
# MBOX_VIEWER_HOST=127.0.0.1
# MBOX_VIEWER_PORT=8000

# --- docker compose only (see DOCKER_SETUP.md) ---
# MBOX_DIR=/mnt/tank/mail
# MBOX_FILE=emails.mbox
# INDEX_DIR=/mnt/tank/apps/mbox-viewer
# PUID=1000
# PGID=1000
# COMPOSE_PROFILES=rag
# INDEX_EMBEDDINGS=auto
# MBOX_VIEWER_BIND=127.0.0.1
# MBOX_VIEWER_PORT=8000
